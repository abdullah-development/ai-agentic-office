# deps / build
node_modules/
.next/
.next-*/
*.log

# secrets — tracker API keys live here and must never be committed
.env.local
.env*.local

# macOS
.DS_Store

# Claude Code scratch
.claude/.cc-writes/

# ---- per-machine floor state ----
# A floor is personal: which offices exist, which project folder each one owns,
# which agents sit in it, and the Claude session UUIDs backing their terminals.
# None of that travels — clone, run, and build your own floor in the UI.
# `data/state.example.json` is the committed starting point; the server copies it
# to `data/state.json` on first boot.
data/state.json
data/agent-sessions.json
# the tracker backlog the poller caches per office
data/tickets/

# Office and floor memory are the agents' own notes about *your* projects.
data/memory/*.md
!data/memory/README.md

# ---- the floor layer ----
# Agent mailboxes, the task ledger, the event feed, the live fleet snapshot, and
# the per-agent settings files that carry the lifecycle hooks. All per-machine and
# all rebuilt at boot from data/state.json — and the mail is the agents' own.
data/floor/
# the running server's claim on the floor (see test/floor.js)
data/.floor.pid
