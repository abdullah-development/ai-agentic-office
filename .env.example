# Copy to .env.local (git-ignored) and fill in. The server reads this at boot.

# ---- Plane ----
# Workspace API key: Plane → Workspace Settings → API Tokens
PLANE_API_KEY=
# Cloud default; point at your own host for self-hosted Plane
PLANE_BASE_URL=https://api.plane.so
# Where issue links should point (the web UI, not the API)
PLANE_APP_URL=https://app.plane.so

# ---- Jira (provider not implemented yet) ----
# JIRA_BASE_URL=https://your-org.atlassian.net
# JIRA_EMAIL=
# JIRA_API_TOKEN=

# ---- Linear (provider not implemented yet) ----
# LINEAR_API_KEY=

# ---- polling ----
# How often each office's board is pulled, in ms. 0 disables it.
TRACKER_POLL_MS=210000
# Set to 0 to stop the server typing a nudge into the lead's terminal.
TRACKER_NUDGE=1
